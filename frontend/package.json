{
    "name": "moneta",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "export $(cat .env | xargs) && vite dev",
        "preview": "export $(cat .env | xargs) && vite preview",
        "build": "vite build",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint ."
    },
    "devDependencies": {
        "@eslint/compat": "^1.3.1",
        "@eslint/js": "^9.31.0",
        "@sveltejs/adapter-auto": "^6.0.1",
        "@sveltejs/adapter-node": "^5.2.13",
        "@sveltejs/kit": "^2.25.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.0",
        "@tailwindcss/vite": "^4.1.11",
        "@urql/svelte": "^5.0.0",
        "eslint": "^9.31.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.11.0",
        "flowbite": "^3.1.2",
        "flowbite-svelte": "^1.10.15",
        "flowbite-svelte-blocks": "^2.0.0",
        "flowbite-svelte-icons": "^3.0.0",
        "globals": "^17.0.0",
        "graphql": "^16.11.0",
        "houdini": "^1.5.9",
        "houdini-svelte": "^2.1.19",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "svelte": "^5.36.13",
        "svelte-awesome-color-picker": "^4.0.2",
        "svelte-check": "^4.3.0",
        "tailwindcss": "^4.1.11",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.38.0",
        "vite": "^7.1.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@tailwindcss/oxide",
            "esbuild"
        ]
    }
}
